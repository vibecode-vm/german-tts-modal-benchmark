  },
  {
    "model": "mms",
    "sample": "00_agent",
    "text": "Guten Tag, hier spricht die Buchhaltung von Servas AI.",
    "voice": "default",
    "wall_s": 0.997353145154193,
    "cold": false,
    "synth_s": 0.147,
    "audio_s": 4.24,
    "rtf": 0.0347,
    "file": "audio_out/mms__dialog__00_agent.wav",
    "phase": "dialog"
  },
  {
    "model": "mms",
    "sample": "01_agent",
    "text": "Wir benötigen noch Ihre Rechnung vom April zweitausendsechsundzwanzig.",
    "voice": "default",
    "wall_s": 1.2219089320860803,
    "cold": false,
    "synth_s": 0.1366,
    "audio_s": 4.672,
    "rtf": 0.0292,
    "file": "audio_out/mms__dialog__01_agent.wav",
    "phase": "dialog"
  },
  {
    "model": "mms",
    "sample": "02_user",
    "text": "Guten Tag. Können Sie mir sagen, wo ich diese Rechnung finde?",
    "voice": "default",
    "wall_s": 1.0735449199564755,
    "cold": false,
    "synth_s": 0.1296,
    "audio_s": 4.016,
    "rtf": 0.0323,
    "file": "audio_out/mms__dialog__02_user.wav",
    "phase": "dialog"
  },
  {
    "model": "mms",
    "sample": "03_agent",
    "text": "Selbstverständlich. Die finden Sie in Ihrem Kundenportal unter dem Punkt Rechnungen.",
    "voice": "default",
    "wall_s": 1.0789914480410516,
    "cold": false,
    "synth_s": 0.1354,
    "audio_s": 5.44,
    "rtf": 0.0249,
    "file": "audio_out/mms__dialog__03_agent.wav",
    "phase": "dialog"
  },
  {
    "model": "mms",
    "sample": "04_user",
    "text": "Verstehe. Und wo genau soll ich die Datei dann hochladen?",
    "voice": "default",
    "wall_s": 1.145602636039257,
    "cold": false,
    "synth_s": 0.1359,
    "audio_s": 4.8,
    "rtf": 0.0283,
    "file": "audio_out/mms__dialog__04_user.wav",
    "phase": "dialog"
  },
  {
    "model": "mms",
    "sample": "05_agent",
    "text": "Sie erhalten gleich eine E-Mail mit einem persönlichen Upload-Link.",
    "voice": "default",
    "wall_s": 1.221669773105532,
    "cold": false,
    "synth_s": 0.134,
    "audio_s": 5.392,
    "rtf": 0.0249,
    "file": "audio_out/mms__dialog__05_agent.wav",
    "phase": "dialog"
  },
  {
    "model": "mms",
    "sample": "06_agent",
    "text": "Bitte laden Sie die Rechnung über diesen Link hoch, nicht per Antwort-Mail.",
    "voice": "default",
    "wall_s": 1.2408310768660158,
    "cold": false,
    "synth_s": 0.1327,
    "audio_s": 4.368,
    "rtf": 0.0304,
    "file": "audio_out/mms__dialog__06_agent.wav",
    "phase": "dialog"
  },
  {
    "model": "mms",
    "sample": "07_user",
    "text": "Alles klar. Bis wann muss das erledigt sein?",
    "voice": "default",
    "wall_s": 1.0732936731074005,
    "cold": false,
    "synth_s": 0.1348,
    "audio_s": 3.488,
    "rtf": 0.0387,
    "file": "audio_out/mms__dialog__07_user.wav",
    "phase": "dialog"
  },
  {
    "model": "mms",
    "sample": "08_agent",
    "text": "Spätestens bis Freitag, den dreiundzwanzigsten Mai, achtzehn Uhr.",
    "voice": "default",
    "wall_s": 1.0404054948594421,
    "cold": false,
    "synth_s": 0.134,
    "audio_s": 4.992,
    "rtf": 0.0269,
    "file": "audio_out/mms__dialog__08_agent.wav",
    "phase": "dialog"
  },
  {
    "model": "mms",
    "sample": "09_user",
    "text": "Wunderbar. Vielen Dank für die Information, auf Wiederhören.",
    "voice": "default",
    "wall_s": 0.9964306119363755,
    "cold": false,
    "synth_s": 0.1318,
    "audio_s": 3.872,
    "rtf": 0.034,
